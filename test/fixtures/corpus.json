        "nowMs": 1754179200001,
        "response": "{\"protocolVersion\":1,\"ok\":true,\"op\":\"generate\",\"requestId\":null,\"durationMs\":0,\"result\":\"4SQ1NZT5HC0-4SQ1NZT5P1S\"}"
