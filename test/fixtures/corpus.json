        "nowMs": 1754179200000,
        "response": "{\"protocolVersion\":1,\"ok\":false,\"op\":\"decodeTime\",\"requestId\":null,\"durationMs\":0,\"error\":{\"name\":\"Error\",\"message\":\"Machine request field \\\"id\\\" must be a non-empty string\"}}"
      },
